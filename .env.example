# Copy to .env and fill in. Never commit the real .env file.

# Market data API (if your data source requires a key)
MARKET_DATA_API_KEY=

# Notification email (sent via SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# AWS (only needed once deployed, e.g. Lambda + EventBridge)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
