# Copy to .env and fill in. Never commit the real .env file.

# Market data API (if your data source requires a key)
MARKET_DATA_API_KEY=

# Notification target (webhook URL, e.g. Slack/Discord, or an email service)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_TO=

# AWS (only needed once deployed, e.g. Lambda + EventBridge)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
