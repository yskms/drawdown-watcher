# Copy to .env and fill in. Never commit the real .env file.

# Market data API (if your data source requires a key)
MARKET_DATA_API_KEY=

# Notification email (sent via SMTP). SMTP_PORT must be a STARTTLS port
# (587) -- implicit TLS (465) is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Leave blank to fall back to SMTP_USERNAME as the From address.
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
